<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="TrackingDb" connectionString="Data Source=sql01.pellworth.test;Initial Catalog=Tracking;User ID=tracking_app;Password=Fr8ight-Yard-77;" providerName="System.Data.SqlClient" />
    <add name="ReportsDb" connectionString="Data Source=sql01.pellworth.test;Initial Catalog=Reports;Integrated Security=SSPI;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ManifestExportFolder" value="D:\Pellworth\Manifests" />
    <add key="ProofOfDeliveryStorage" value="DefaultEndpointsProtocol=https;AccountName=pellworthpod;AccountKey=bm90LWEtcmVhbC1rZXktanVzdC1hLWZpeHR1cmU=" />
    <add key="CarrierPortalPassword" value="#{CarrierPortalPassword}#" />
    <!-- <add key="OldFtpPassword" value="dock-door-4" /> -->
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral" />
        <add assembly="Pellworth.Legacy.Barcode, Version=3.1.0.0, Culture=neutral, PublicKeyToken=8c1d4f7a6b3e5d92" />
        <add assembly="Newtonsoft.Json, Version=6.0.0.0, Culture=neutral" />
      </assemblies>
    </compilation>
    <authentication mode="Windows" />
    <identity impersonate="true" />
    <sessionState mode="InProc" timeout="40" />
    <httpModules>
      <add name="YardAudit" type="Pellworth.Tracking.Modules.YardAuditModule, Pellworth.Tracking" />
    </httpModules>
  </system.web>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="SpecifiedPickupDirectory">
        <specifiedPickupDirectory pickupDirectoryLocation="C:\inetpub\mailroot\Pickup" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.webServer>
    <modules>
      <add name="YardAudit" type="Pellworth.Tracking.Modules.YardAuditModule, Pellworth.Tracking" />
    </modules>
    <handlers>
      <add name="ManifestImage" path="manifest.img" verb="GET" modules="IsapiModule" scriptProcessor="C:\Pellworth\Isapi\ManifestImage.dll" resourceType="Unspecified" />
      <add name="TrackingFeed" path="feed.axd" verb="GET" type="System.Web.Handlers.TransferRequestHandler" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="Old tracking links" stopProcessing="true">
          <match url="^track\.aspx$" />
          <action type="Redirect" url="shipments/{C:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
